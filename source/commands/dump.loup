@mode(host.dual)

# The four dump styles: the default hex dump, -b (bits), -p (plain hex) and
# -i (a C array). Each takes the input bytes and the range [start, end) to
# show, and pushes the output, piece by piece, into a Sink (see sink.loup),
# which writes it in blocks. The pieces come from tables made once per dump
# (byte cells, offset digits, runs of spaces), so that no string is built
# per line or per byte: natively such strings are never freed.
#
# Runtime: host.dual. Compiled into the native binary build/xxd by
# `make build`; `loup run source/main.loup` interprets the same code, and
# tests/dump_test.loup exercises it under Stage0 (`make test`), collecting
# the output in memory.

from commands.sink import (Sink, sink_put);

const HEX_DIGITS: string = "0123456789abcdef";
const SPACES: string = "                                                                ";

# Two hex digits for every byte value, in lower or upper case.
pub func hex_table(upper: bool): list[string] {
    let digits = if (upper) { HEX_DIGITS.toUpperCase() } else { HEX_DIGITS };
    let table: list[string] = [digits.slice(b / 16, b / 16 + 1) + digits.slice(b % 16, b % 16 + 1) for b in 0..256];
    return table;
}

# Eight binary digits for every byte value.
pub func bits_table(): list[string] {
    var table: list[string] = [];
    for (b in 0..256) {
        var text = "";
        for (var bit = 128; bit > 0; bit = bit >> 1) {
            text += if ((b & bit) != 0) { "1" } else { "0" };
        }
        table.push(text);
    }
    return table;
}

# The character column: printable ASCII as itself, anything else as `.`.
pub func char_table(): list[string] {
    let table: list[string] = [if (b > 31 and b < 127) { str(char.of(b)) } else { "." } for b in 0..256];
    return table;
}

# The one-digit strings "0" to "f", for offsets.
pub func digit_table(): list[string] {
    let table: list[string] = [HEX_DIGITS.slice(d, d + 1) for d in 0..16];
    return table;
}

# Runs of 0 to 64 spaces, for padding.
pub func spaces_table(): list[string] {
    let table: list[string] = [SPACES.slice(0, n) for n in 0..SPACES.len() + 1];
    return table;
}

# A file offset as at least eight lower-case hex digits (C's "%08lx"),
# one digit piece at a time from `digits` (digit_table()).
pub func push_offset(edits out: Sink, n: int, digits: list[string]): void {
    # The shift of the leading digit: 28 for eight digits, more only when
    # the offset needs them.
    var shift = 28;
    while (shift < 60 and (n >> (shift + 4)) > 0) {
        shift += 4;
    }
    do {
        sink_put(edits: out, digits[(n >> shift) & 15]);
        shift -= 4;
    } while (shift >= 0);
}

func push_spaces(edits out: Sink, count: int, spaces: list[string]): void {
    let most = spaces.len() - 1;
    var left = count;
    while (left > 0) {
        let n = if (left > most) { most } else { left };
        sink_put(edits: out, spaces[n]);
        left -= n;
    }
}

# The default dump (and -b with `bits`): an offset, `cols` bytes in groups of
# `group`, and the characters. A short last line is padded so that its
# characters line up with the lines above.
pub func dump_lines(data: bytes, start: int, end: int, cols: int, group: int, upper: bool, bits: bool, edits out: Sink): void {
    let cells = if (bits) { bits_table() } else { hex_table(upper) };
    let shown = char_table();
    let offset_digits = digit_table();
    let spaces = spaces_table();
    let digits = if (bits) { 8 } else { 2 };
    let group_width = digits * group + 1;
    # Width of a full line's byte columns (xxd: (grplen * cols - 1) / octspergrp).
    let width = (group_width * cols - 1) / group;
    var pos = start;
    while (pos < end) {
        let count = if (end - pos < cols) { end - pos } else { cols };
        push_offset(edits: out, pos, offset_digits);
        sink_put(edits: out, ": ");
        for (k in 0..count) {
            if (k > 0 and k % group == 0) {
                sink_put(edits: out, " ");
            }
            sink_put(edits: out, cells[data[pos + k]]);
        }
        let used = count * digits + (count - 1) / group;
        push_spaces(edits: out, width - used + 2, spaces);
        for (k in 0..count) {
            sink_put(edits: out, shown[data[pos + k]]);
        }
        sink_put(edits: out, "\n");
        pos += count;
    }
}

# -p: bare hex digits, `cols` bytes per line; 0 means a single line (a
# lone newline when there is nothing to dump). Each line is one slice of
# the input turned into hex by bytes.toHex().
pub func plain_lines(data: bytes, start: int, end: int, cols: int, upper: bool, edits out: Sink): void {
    if (start >= end) {
        if (cols == 0) {
            sink_put(edits: out, "\n");
        }
        return;
    }
    let step = if (cols > 0) { cols } else { end - start };
    var pos = start;
    while (pos < end) {
        let stop = if (end - pos < step) { end } else { pos + step };
        let hex: string = data.slice(pos, stop).toHex();
        sink_put(edits: out, if (upper) { hex.toUpperCase() } else { hex });
        sink_put(edits: out, "\n");
        pos = stop;
    }
}

# The C identifier xxd derives from a file name: other characters become
# `_`, and a leading digit gets a `__` prefix.
pub func c_name(file_name: string): string {
    var name = "";
    for (ch in file_name) {
        let alnum = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9");
        name += if (alnum and ch.len() == 1) { ch } else { "_" };
    }
    let first = file_name.slice(0, 1);
    if (first >= "0" and first <= "9" and first.len() == 1) {
        name = "__" + name;
    }
    return name;
}

# -i: the bytes as a C initializer, `cols` per line, as hex literals or
# (with -b) binary ones. With a variable name (when the input is a named
# file) the array declaration and a length variable surround it.
pub func include_lines(data: bytes, start: int, end: int, cols: int, upper: bool, bits: bool, name: string, edits out: Sink): void {
    let cells = if (bits) { bits_table() } else { hex_table(upper) };
    let prefix = if (bits) { "0b" } else if (upper) { "0X" } else { "0x" };
    if (name.len() > 0) {
        sink_put(edits: out, "unsigned char " + name + "[] = {\n");
    }
    var p = 0;
    for (pos in start..end) {
        if (p % cols != 0) {
            sink_put(edits: out, ", ");
        } else if (p == 0) {
            sink_put(edits: out, "  ");
        } else {
            sink_put(edits: out, ",\n  ");
        }
        sink_put(edits: out, prefix);
        sink_put(edits: out, cells[data[pos]]);
        p += 1;
    }
    if (p > 0) {
        sink_put(edits: out, "\n");
    }
    if (name.len() > 0) {
        sink_put(edits: out, "};\n");
        sink_put(edits: out, "unsigned int " + name + "_len = " + str(p) + ";\n");
    }
}
