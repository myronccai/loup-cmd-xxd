@mode(host.dual)

from appinfo import (APP_NAME, EXIT_OK, EXIT_USAGE);
from cli.args import (parse_args, plain_message, layout);
from cli.usage import (usage, version_line);
from commands.xxd import (run_xxd);

func usage_error(msg: string): int {
    printErr(i"{$ APP_NAME $}: {$ msg $}");
    if (!plain_message(msg)) {
        printErr(i"Try '{$ APP_NAME $} -h' for more information.");
    }
    return EXIT_USAGE;
}

# Parses argv, runs xxd and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            return usage_error(msg);
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    let (cols, group) = match layout(opts) {
        Ok(pair) => pair,
        Err(msg) => {
            return usage_error(msg);
        },
    };

    try {
        return run_xxd(opts, cols, group);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_USAGE;
    }
}
