@mode(host.dual)

# Exit statuses of the whole command line. These tests print the program's
# normal output and error messages.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_USAGE, EXIT_INPUT, EXIT_SEEK);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["-v"]), EXIT_OK, "-v");
}

func test_help_succeeds(): void {
    expectEq(run(["-h"]), EXIT_OK, "-h");
}

func test_dump_succeeds(): void {
    expectEq(run(["-l", "8", "tests/fixtures/sample.txt"]), EXIT_OK, "dump");
}

func test_missing_file(): void {
    expectEq(run(["tests/fixtures/none.bin"]), EXIT_INPUT, "missing");
}

func test_bad_seek(): void {
    expectEq(run(["-s", "-1000", "tests/fixtures/sample.txt"]), EXIT_SEEK, "before the start");
}

func test_usage_errors(): void {
    expectEq(run(["-z"]), EXIT_USAGE, "unknown option");
    expectEq(run(["-c", "999", "tests/fixtures/sample.txt"]), EXIT_USAGE, "too many columns");
}
