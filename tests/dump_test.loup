@mode(host.dual)

# Unit tests for the dump styles (source/commands/dump.loup): the lookup
# tables, offsets, hex and bits lines, little-endian (-e) lines, -p, -i and
# C names. The -e lines were checked against xxd 2024-12-07.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test per
# `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from commands.dump import (hex_table, bits_table, char_table, digit_table, spaces_table, push_offset, dump_lines, plain_lines,
    include_lines, c_name);
from commands.sink import (Sink, collector, collected, file_sink, sink_put, sink_flush);
from io.fs import (createDir, readText);
from system.text import (toHex);
from core.interchange import (Endianness);

# The dump styles write into a Sink; these collect their output as text.
func dump(data: bytes, start: int, end: int, cols: int, group: int, upper: bool, bits: bool): string {
    var s = collector();
    dump_lines(data, start, end, cols, group, upper, bits, Endianness.BigEndian, edits: s);
    return collected(s);
}

# The -e dump: each group as a little-endian number.
func dump_le(data: bytes, start: int, end: int, cols: int, group: int, upper: bool): string {
    var s = collector();
    dump_lines(data, start, end, cols, group, upper, false, Endianness.LittleEndian, edits: s);
    return collected(s);
}

func plain(data: bytes, start: int, end: int, cols: int, upper: bool): string {
    var s = collector();
    plain_lines(data, start, end, cols, upper, edits: s);
    return collected(s);
}

func include(data: bytes, start: int, end: int, cols: int, upper: bool, bits: bool, name: string): string {
    var s = collector();
    include_lines(data, start, end, cols, upper, bits, name, edits: s);
    return collected(s);
}

func offset(n: int): string {
    var s = collector();
    push_offset(edits: s, n, digit_table());
    return collected(s);
}

func sample(): bytes {
    return bytesFromInts([72, 105, 0, 127, 128, 255, 10]);
}

func test_tables(): void {
    expectEq(hex_table(false)[171], "ab", "lower case");
    expectEq(hex_table(true)[171], "AB", "upper case");
    expectEq(bits_table()[5], "00000101", "bits");
    expectEq(char_table()[65], "A", "printable");
    expectEq(char_table()[127], ".", "DEL is not printable");
    expectEq(char_table()[200], ".", "high bytes are dots");
}

func test_offsets(): void {
    expectEq(offset(0), "00000000", "zero");
    expectEq(offset(255), "000000ff", "padded");
    expectEq(offset(4294967296), "100000000", "more than eight digits");
}

func test_hex_lines(): void {
    let out = dump(sample(), 0, 7, 4, 2, false, false);
    expectEq(out, "00000000: 4869 007f  Hi..\n00000004: 80ff 0a    ...\n", "two lines, the second padded");
}

func test_odd_group_size(): void {
    let out = dump(sample(), 0, 7, 5, 2, true, false);
    expectEq(out, "00000000: 4869 007F 80  Hi...\n00000005: FF0A          ..\n", "groups of 2 in 5 columns");
}

func test_start_offset(): void {
    let out = dump(sample(), 5, 7, 16, 2, false, false);
    expectEq(out, "00000005: ff0a                                     ..\n", "offset of the first byte shown");
}

func test_little_endian_lines(): void {
    expectEq(dump_le(sample(), 0, 7, 4, 4, false), "00000000: 7f006948  Hi..\n00000004:   0aff80  ...\n", "a short group keeps its width, digits to the right");
    expectEq(dump_le(sample(), 0, 7, 8, 4, false), "00000000: 7f006948   0aff80  Hi.....\n", "one short line");
    expectEq(dump_le(sample(), 0, 7, 6, 4, false), "00000000: 7f006948     ff80  Hi....\n00000006:       0a           .\n", "-c 6: every line ends in half a group");
    expectEq(dump_le(sample(), 0, 7, 16, 8, false), "00000000:   0aff807f006948                   Hi.....\n", "groups of 8");
    expectEq(dump_le(sample(), 0, 7, 4, 2, true), "00000000: 6948 7F00  Hi..\n00000004: FF80   0A  ...\n", "groups of 2, upper case");
    expectEq(dump_le(sample(), 1, 3, 4, 4, false), "00000001:     0069  i.\n", "from an offset");
}

func test_bits_lines(): void {
    let out = dump(sample(), 0, 2, 6, 1, false, true);
    # Six columns of 8 digits and a space: 53 characters, then two spaces.
    expectEq(out, "00000000: 01001000 01101001" + " ".repeat(38) + "Hi\n", "bits");
}

func test_plain(): void {
    expectEq(plain(sample(), 0, 7, 3, false), "486900\n7f80ff\n0a\n", "3 per line");
    expectEq(plain(sample(), 0, 6, 3, false), "486900\n7f80ff\n", "no empty last line");
    expectEq(plain(sample(), 0, 7, 0, true), "4869007F80FF0A\n", "one line");
    expectEq(plain(sample(), 0, 0, 30, false), "", "nothing for no input");
}

func test_include(): void {
    let out = include(sample(), 0, 3, 2, false, false, "data");
    expectEq(out, "unsigned char data[] = {\n  0x48, 0x69,\n  0x00\n};\nunsigned int data_len = 3;\n", "named array");
    expectEq(include(sample(), 0, 2, 12, true, false, ""), "  0X48, 0X69\n", "no name for stdin");
    expectEq(include(sample(), 0, 1, 12, false, true, ""), "  0b01001000\n", "binary literals");
}

func test_c_names(): void {
    expectEq(c_name("dir/file.bin"), "dir_file_bin", "punctuation becomes _");
    expectEq(c_name("3d.obj"), "__3d_obj", "a leading digit gets __");
}

# system.text.toHex (Stage0 only, so it serves only as a test oracle) gives
# the same digits as the -p lines joined together.
func test_plain_agrees_with_to_hex(): void {
    var codes: list[int] = [];
    for (k in 0..300) {
        codes.push((k * 37 + 11) % 256);
    }
    let data = bytesFromInts(codes);
    expectEq(plain(data, 0, 300, 0, false), toHex(data) + "\n", "-c 0: one line");
    let lines = plain(data, 0, 300, 30, false).split("\n");
    expectEq(lines.len(), 11, "ten lines of 30 bytes and an empty piece");
    expectEq(lines.join(""), toHex(data), "the same digits");
    expectEq(plain(data, 0, 3, 30, true), toHex(data.slice(0, 3)).toUpperCase() + "\n", "-u");
    expectEq(plain(data, 5, 5, 30, false), "", "nothing to dump");
    expectEq(plain(data, 5, 5, 0, false), "\n", "-c 0 with nothing to dump");
}

func test_offsets_have_eight_digits(): void {
    expectEq(offset(0), "00000000", "zero");
    expectEq(offset(4294967296), "100000000", "more than eight digits");
}

func test_piece_tables(): void {
    expectEq(digit_table()[10], "a", "offset digits");
    expectEq(spaces_table()[3], "   ", "a run of spaces");
    expectEq(spaces_table().len(), 65, "runs of 0 to 64 spaces");
    expectEq(offset(305419896), "12345678", "eight digits, no padding needed");
}

# A file sink writes in blocks of 65,536 pieces as they come; the file holds
# exactly what was put, across block boundaries.
func test_file_sink_writes_in_blocks(): void {
    createDir(".temp/xxd-unit");
    var s = file_sink(".temp/xxd-unit/out.txt");
    for (k in 0..70000) {
        sink_put(edits: s, if (k % 2 == 0) { "ab" } else { "\n" });
    }
    expectEq(s.pieces.len(), 70000 - 65536, "the first block was written");
    sink_flush(edits: s);
    let text = readText(".temp/xxd-unit/out.txt");
    expectEq(text.len(), 105000, "35,000 lines of three characters");
    expect(text.startsWith("ab\nab\n") and text.endsWith("ab\n"), "in order");
}
